# ============================================================
# UF Stock Assistant 环境变量配置模板
# 复制为 .env 后按需填写，.env 文件不会被提交到 Git
# ============================================================

# -----------------------------------------------------------
# LLM Provider 选择（kimi | xiaomi | openai | deepseek）
# -----------------------------------------------------------
STOCK_ASSISTANT_LLM_PROVIDER=kimi

# -----------------------------------------------------------
# Kimi (Moonshot AI) 配置
# -----------------------------------------------------------
KIMI_LLM_API_KEY=
KIMI_LLM_MODEL=kimi-k2
KIMI_LLM_BASE_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_LLM_TEMPERATURE=0.1
KIMI_LLM_MAX_TOKENS=4096
KIMI_LLM_TIMEOUT=180
KIMI_LLM_MAX_RETRIES=2
KIMI_LLM_RETRY_BACKOFF=1.0
KIMI_LLM_USER_AGENT=

# -----------------------------------------------------------
# Xiaomi MiMo 配置
# -----------------------------------------------------------
XIAOMI_LLM_API_KEY=
XIAOMI_LLM_MODEL=MiMo-72B
XIAOMI_LLM_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1/chat/completions
XIAOMI_LLM_TEMPERATURE=0.1
XIAOMI_LLM_MAX_TOKENS=4096
XIAOMI_LLM_TIMEOUT=180
XIAOMI_LLM_MAX_RETRIES=2
XIAOMI_LLM_RETRY_BACKOFF=1.0
XIAOMI_LLM_USER_AGENT=

# -----------------------------------------------------------
# OpenAI / OpenAI-Compatible 配置
# -----------------------------------------------------------
OPENAI_LLM_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_LLM_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_LLM_TEMPERATURE=0.1
OPENAI_LLM_MAX_TOKENS=4096
OPENAI_LLM_TIMEOUT=180
OPENAI_LLM_MAX_RETRIES=2
OPENAI_LLM_RETRY_BACKOFF=1.0

# -----------------------------------------------------------
# DeepSeek 配置
# -----------------------------------------------------------
DEEPSEEK_LLM_API_KEY=
DEEPSEEK_LLM_MODEL=deepseek-chat
DEEPSEEK_LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_LLM_TEMPERATURE=0.1
DEEPSEEK_LLM_MAX_TOKENS=4096
DEEPSEEK_LLM_TIMEOUT=180
DEEPSEEK_LLM_MAX_RETRIES=2
DEEPSEEK_LLM_RETRY_BACKOFF=1.0

# -----------------------------------------------------------
# 日志配置
# -----------------------------------------------------------
STOCK_ASSISTANT_LOG_LEVEL=INFO
STOCK_ASSISTANT_LOG_DIR=logs
STOCK_ASSISTANT_LOG_JSON=true

# -----------------------------------------------------------
# 数据库配置
# -----------------------------------------------------------
STOCK_ASSISTANT_DATABASE_URL=sqlite:///data/assistant.db

# -----------------------------------------------------------
# 数据缓存配置
# -----------------------------------------------------------
STOCK_ASSISTANT_CACHE_TTL=300
STOCK_ASSISTANT_CACHE_MAX_SIZE=1000

# -----------------------------------------------------------
# 计费与商业化配置（默认关闭）
# -----------------------------------------------------------
# 全局计费开关
STOCK_ASSISTANT_BILLING_ENABLED=false
# 各功能单次消耗积分（0 表示免费）
STOCK_ASSISTANT_BILLING_COST_AI_ANALYSIS=10
STOCK_ASSISTANT_BILLING_COST_AI_CODE_GEN=30
# 注册/邀请赠送积分
STOCK_ASSISTANT_BILLING_CREDITS_REGISTER_BONUS=100
STOCK_ASSISTANT_BILLING_CREDITS_REFERRAL_BONUS=50

# 会员套餐价格（USD）与积分
STOCK_ASSISTANT_MEMBERSHIP_MONTHLY_PRICE_USD=19.9
STOCK_ASSISTANT_MEMBERSHIP_MONTHLY_CREDITS=500
STOCK_ASSISTANT_MEMBERSHIP_YEARLY_PRICE_USD=199
STOCK_ASSISTANT_MEMBERSHIP_YEARLY_CREDITS=8000
STOCK_ASSISTANT_MEMBERSHIP_LIFETIME_PRICE_USD=499
STOCK_ASSISTANT_MEMBERSHIP_LIFETIME_MONTHLY_CREDITS=800

# USDT-TRC20 支付配置（需 bip_utils + TronGrid API Key）
STOCK_ASSISTANT_USDT_PAY_ENABLED=false
STOCK_ASSISTANT_USDT_CHAIN=TRC20
STOCK_ASSISTANT_USDT_TRC20_XPUB=
STOCK_ASSISTANT_USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
STOCK_ASSISTANT_USDT_TRONGRID_BASE_URL=https://api.trongrid.io
STOCK_ASSISTANT_USDT_TRONGRID_API_KEY=
STOCK_ASSISTANT_USDT_CONFIRM_SECONDS=30
STOCK_ASSISTANT_USDT_ORDER_EXPIRE_MINUTES=30
STOCK_ASSISTANT_USDT_WORKER_POLL_INTERVAL=30
